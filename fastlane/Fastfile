require 'fileutils'

default_platform(:android)

# Absolute path to the repository root.
#
# fastlane evaluates the Fastfile with the working directory set to fastlane/, so
# repo-relative paths are not safe to assume (hence the "../" in the release lanes
# below). Resolve paths through this helper instead of guessing at the CWD.
def repo_root
  @repo_root ||= `git rev-parse --show-toplevel`.strip
end

# Resolve the Android SDK location the same way the root Gradle build does:
# ANDROID_HOME, then ANDROID_SDK_ROOT, then sdk.dir in local.properties.
def android_sdk_dir
  %w[ANDROID_HOME ANDROID_SDK_ROOT].each do |var|
    value = ENV[var].to_s
    return value unless value.empty?
  end

  properties = File.join(repo_root, "local.properties")
  if File.exist?(properties)
    entry = File.readlines(properties).find { |line| line.start_with?("sdk.dir=") }
    return entry.to_s.split("=", 2).last.to_s.strip
  end

  ""
end

# apkscale needs more of the SDK environment than the root Gradle build does, and
# neither requirement is satisfied on a stock developer machine:
#
#   1. It runs measureSize in a NESTED Gradle build under verify_sna/build/apkscale/,
#      which does not inherit the root project's local.properties and so can find
#      the SDK only through ANDROID_HOME.
#   2. It shells out to `apkanalyzer`, which ships in cmdline-tools and is not
#      necessarily on PATH.
#
# CI images generally provide both, which is why this never surfaced in CircleCI.
# Setting them here keeps the lane runnable anywhere.
def ensure_android_sdk_env
  sdk_dir = android_sdk_dir
  if sdk_dir.empty?
    UI.user_error!(
      "Android SDK not found. Set ANDROID_HOME (CI images normally do), or add " \
      "sdk.dir=/path/to/sdk to local.properties."
    )
  end
  ENV["ANDROID_HOME"] = sdk_dir

  tools_bin = File.join(sdk_dir, "cmdline-tools", "latest", "bin")
  unless File.directory?(tools_bin)
    UI.important(
      "cmdline-tools not found at #{tools_bin}. apkscale invokes apkanalyzer from " \
      "there; install it with: sdkmanager --install \"cmdline-tools;latest\""
    )
    return
  end

  entries = ENV["PATH"].to_s.split(File::PATH_SEPARATOR)
  ENV["PATH"] = ([tools_bin] + entries).join(File::PATH_SEPARATOR) unless entries.include?(tools_bin)
  UI.message("Android SDK: #{sdk_dir} (apkanalyzer available for apkscale)")
end

platform :android do

  # ---------------------------------------------------------------------------
  # CI lanes
  #
  # One lane per CI job. These hold the logic that used to sit inline in
  # .circleci/config.yml, so the CI config carries no logic of its own and the
  # whole pipeline can be run from any CI platform or a laptop.
  # ---------------------------------------------------------------------------

  desc "Assemble all variants"
  lane :assemble do
    gradle(task: "assemble", flags: "--no-daemon")
  end

  desc "Run ktlint over the project"
  lane :lint do
    gradle(task: "ktlintCheck")
  end

  desc "Run unit tests and generate the Kover coverage report"
  lane :test do
    gradle(
      tasks: ["verify_sna:koverXmlReportDebug", "verify_sna:koverVerify"],
      flags: "--no-daemon"
    )
  end

  desc "Report unit test coverage to the pull request via Danger"
  lane :report_code_coverage do
    danger(
      danger_id: "code_coverage_report",
      dangerfile: File.join(repo_root, "dangerfiles/code_coverage_reporter")
    )
  end

  desc "Generate the SDK size impact report and stage it in builds/"
  lane :size_report do
    ensure_android_sdk_env

    # --no-daemon matters here, unlike in the original CircleCI step. Gradle runs
    # exec tasks inside the daemon using the DAEMON's environment, so a daemon
    # already running without apkanalyzer on PATH cannot launch it even after
    # ensure_android_sdk_env fixes the client's PATH. A single-use daemon inherits
    # the corrected environment.
    gradle(task: ":verify_sna:generateSizeReport", flags: "--no-daemon")

    # builds/ is this lane's output contract: the release lanes read
    # builds/sizeReport/VerifySNASDKSizeReport.txt from it, and it is the
    # directory that crosses job boundaries as a CI artifact.
    destination = File.join(repo_root, "builds")
    FileUtils.mkdir_p(destination)
    FileUtils.cp_r(File.join(repo_root, "verify_sna/build/outputs/sizeReport"), destination)
    UI.success("Size report staged in #{destination}/sizeReport")
  end

  desc "Materialize the GPG signing keyring from the base64-encoded SIGNING_KEY"
  lane :install_signing_key do
    key = ENV.fetch("SIGNING_KEY")
    path = ENV.fetch("SIGNING_SECRET_KEY_RING_FILE")

    unless path.start_with?("/")
      UI.important(
        "SIGNING_SECRET_KEY_RING_FILE is relative (#{path}). Prefer an absolute " \
        "path: Gradle resolves it independently of fastlane, from a different CWD."
      )
    end

    FileUtils.mkdir_p(File.dirname(path))
    # Overwrite rather than append: appending corrupts the keyring on a re-run.
    File.binwrite(path, key.unpack1("m"))
    UI.success("Signing keyring written to #{path} (#{File.size(path)} bytes)")
  end

  # ---------------------------------------------------------------------------
  # Release lanes
  # ---------------------------------------------------------------------------

  desc "Release a new production version"
  lane :release do
    next unless verify(title: "Android Verify SNA", tag_prefix: "*")
    increment_version()
    gradle(task: "sonatypeVerifySnaReleaseUpload")
    post_release()
  end

  desc "Verify next release"
  lane :verify do |options|
    if !is_ci? then
      UI.message("#{options[:title]} deploy was triggered on local machine")
      gradle(task: "clean")
    else
      UI.message("#{options[:title]} deploy was triggered on CI")
    end

    # Check if there is any change since last version
    is_releaseable = analyze_commits(
      match: options[:tag_prefix]
    )
    unless is_releaseable
      UI.important("Skip deploying #{options[:title]}. No changes since last one!")
    end
    is_releaseable
  end

  desc "Increment version"
  lane :increment_version do |options|
    next_version = lane_context[SharedValues::RELEASE_NEXT_VERSION]
    ensure_git_status_clean(
      ignore_files: ["Gemfile.lock"]
    )
    gradle(task: "-q incrementVersion", properties: { 'version_name' => next_version })
  end

  desc "Post release"
  lane :post_release do
    next_version = lane_context[SharedValues::RELEASE_NEXT_VERSION]
    notes = conventional_changelog(
      format: "markdown",
      commit_url: "twilio-verify-sna-android"
    )
    tag = next_version
    sdk_size = sh("cat ../builds/sizeReport/VerifySNASDKSizeReport.txt")
    changelog = "#{notes}\\n\\n#{sdk_size}"
    sh("echo \"#{changelog}\\n\" | cat - ../CHANGELOG.md > temp && mv temp ../CHANGELOG.md")
    git_add(path: ["./verify_sna/gradle.properties", "./CHANGELOG.md"])
    sh("git config user.name \"#{ENV["GH_USER_NAME"]}\"")
    sh("git config user.email \"#{ENV["GH_USER_EMAIL"]}\"")
    sh("git commit -m \"Version bump to #{next_version} [skip ci]\"")
    push_to_git_remote
    add_git_tag(tag: tag)
    push_git_tags(tag: tag)
    set_github_release(
      repository_name: "twilio/twilio-verify-sna-android",
      api_token: ENV["GH_TOKEN"],
      name: tag,
      tag_name: tag,
      description: notes,
      commitish: "main"
    )

    gradle(task: "artifactoryLibraryReleaseUpload")
  end

end
