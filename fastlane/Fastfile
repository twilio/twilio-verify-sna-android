require 'fileutils'
require 'net/http'
require 'uri'

default_platform(:android)

# fastlane runs with the working directory set to fastlane/, not the repo root.
def repo_root
  @repo_root ||= `git rev-parse --show-toplevel`.strip
end

def android_sdk_dir
  %w[ANDROID_HOME ANDROID_SDK_ROOT].each do |var|
    value = ENV[var].to_s
    return value unless value.empty?
  end

  properties = File.join(repo_root, "local.properties")
  if File.exist?(properties)
    entry = File.readlines(properties).find { |line| line.start_with?("sdk.dir=") }
    return entry.to_s.split("=", 2).last.to_s.strip
  end

  ""
end

# apkscale runs measureSize in a nested Gradle build that ignores the root
# local.properties, and shells out to apkanalyzer from cmdline-tools. It needs
# ANDROID_HOME set and cmdline-tools on PATH -- CI images have both, laptops don't.
def ensure_android_sdk_env
  sdk_dir = android_sdk_dir
  if sdk_dir.empty?
    UI.user_error!(
      "Android SDK not found. Set ANDROID_HOME (CI images normally do), or add " \
      "sdk.dir=/path/to/sdk to local.properties."
    )
  end
  ENV["ANDROID_HOME"] = sdk_dir

  tools_bin = File.join(sdk_dir, "cmdline-tools", "latest", "bin")
  unless File.directory?(tools_bin)
    UI.important(
      "cmdline-tools not found at #{tools_bin}. apkscale invokes apkanalyzer from " \
      "there; install it with: sdkmanager --install \"cmdline-tools;latest\""
    )
    return
  end

  entries = ENV["PATH"].to_s.split(File::PATH_SEPARATOR)
  ENV["PATH"] = ([tools_bin] + entries).join(File::PATH_SEPARATOR) unless entries.include?(tools_bin)
  UI.message("Android SDK: #{sdk_dir} (apkanalyzer available for apkscale)")
end

def gradle_property(key)
  properties_file = File.join(repo_root, "gradle.properties")
  entry = File.readlines(properties_file).find { |line| line.start_with?("#{key}=") }
  UI.user_error!("#{key} not found in gradle.properties") unless entry
  entry.split("=", 2).last.strip
end

# Guards `publish` against re-publishing a version Central already has. Checked
# against Central directly rather than the git tag: 0.0.4 shipped to Central but
# its tag/CHANGELOG/GitHub release were lost when the old release lane died
# mid-way, so a tag-based check would have let a duplicate publish through.
def already_published_to_maven_central?(version)
  uri = URI("https://repo1.maven.org/maven2/com/twilio/twilio-verify-sna-android/#{version}/twilio-verify-sna-android-#{version}.pom")
  Net::HTTP.get_response(uri).is_a?(Net::HTTPSuccess)
end

# The topmost "# x.y.z (date)" section of CHANGELOG.md -- the entry a human
# reviewed and merged in the release PR, used verbatim as the GitHub release
# description rather than regenerating notes from commits a second time.
def latest_changelog_entry
  changelog = File.read(File.join(repo_root, "CHANGELOG.md"))
  sections = changelog.split(/^# /)
  UI.user_error!("CHANGELOG.md has no version entries") if sections.size < 2
  "# #{sections[1]}".strip
end

platform :android do

  desc "Assemble all variants"
  lane :assemble do
    gradle(task: "assemble", flags: "--no-daemon")
  end

  desc "Run ktlint over the project"
  lane :lint do
    gradle(task: "ktlintCheck")
  end

  desc "Run unit tests and generate the Kover coverage report"
  lane :test do
    gradle(
      tasks: ["verify_sna:koverXmlReportDebug", "verify_sna:koverVerify"],
      flags: "--no-daemon"
    )
  end

  desc "Report unit test coverage to the pull request via Danger"
  lane :report_code_coverage do
    danger(
      danger_id: "code_coverage_report",
      dangerfile: File.join(repo_root, "dangerfiles/code_coverage_reporter")
    )
  end

  desc "Generate the SDK size impact report and stage it in builds/"
  lane :size_report do
    ensure_android_sdk_env

    # --no-daemon matters here, unlike in the original CircleCI step. Gradle runs
    # exec tasks inside the daemon using the DAEMON's environment, so a daemon
    # already running without apkanalyzer on PATH cannot launch it even after
    # ensure_android_sdk_env fixes the client's PATH. A single-use daemon inherits
    # the corrected environment.
    gradle(task: ":verify_sna:generateSizeReport", flags: "--no-daemon")

    # builds/ is this lane's output contract -- the release lanes read it from here.
    destination = File.join(repo_root, "builds")
    FileUtils.mkdir_p(destination)
    FileUtils.cp_r(File.join(repo_root, "verify_sna/build/outputs/sizeReport"), destination)
    UI.success("Size report staged in #{destination}/sizeReport")
  end

  desc "Materialize the GPG signing keyring from the base64-encoded SIGNING_KEY"
  lane :install_signing_key do
    key = ENV.fetch("SIGNING_KEY")
    path = ENV.fetch("SIGNING_SECRET_KEY_RING_FILE")

    unless path.start_with?("/")
      UI.important(
        "SIGNING_SECRET_KEY_RING_FILE is relative (#{path}). Prefer an absolute " \
        "path: Gradle resolves it independently of fastlane, from a different CWD."
      )
    end

    FileUtils.mkdir_p(File.dirname(path))
    # Overwrite rather than append: appending corrupts the keyring on a re-run.
    File.binwrite(path, key.unpack1("m"))
    UI.success("Signing keyring written to #{path} (#{File.size(path)} bytes)")
  end

  desc "Compute the next version, bump gradle.properties + CHANGELOG.md, and open the release PR"
  lane :prepare_release do
    ensure_git_status_clean(ignore_files: ["Gemfile.lock"])

    is_releaseable = analyze_commits(match: "*")
    UI.user_error!("Nothing releasable since the last tag") unless is_releaseable
    next_version = lane_context[SharedValues::RELEASE_NEXT_VERSION]

    # analyze_commits computes the next version from the last TAG, not from
    # gradle.properties or Maven Central. 0.0.4 shipped to Central without ever
    # being tagged, so it will keep computing "0.0.4" as next until a 0.0.4 tag
    # exists. Catch that here rather than opening a release PR for a version
    # that is already published.
    if already_published_to_maven_central?(next_version)
      UI.user_error!(
        "#{next_version} is already on Maven Central but has no matching git tag "         "-- back-fill the tag on the commit that was actually published, then re-run."
      )
    end

    branch = "release/#{next_version}"
    existing = sh("git ls-remote --heads origin #{branch}", log: false).strip
    UI.user_error!("#{branch} already exists on origin -- delete it or merge its PR first.") unless existing.empty?

    gradle(task: "-q incrementVersion", properties: { "version_name" => next_version })

    notes = conventional_changelog(
      format: "markdown",
      commit_url: "https://github.com/twilio/twilio-verify-sna-android/commit"
    )
    sdk_size = File.read(File.join(repo_root, "builds/sizeReport/VerifySNASDKSizeReport.txt"))
    changelog_path = File.join(repo_root, "CHANGELOG.md")
    File.write(changelog_path, "#{notes}\n\n#{sdk_size}\n#{File.read(changelog_path)}")

    sh("git checkout -b #{branch}")
    git_add(path: ["./gradle.properties", "./CHANGELOG.md"])
    sh("git config user.name \"#{ENV.fetch('GH_USER_NAME')}\"")
    sh("git config user.email \"#{ENV.fetch('GH_USER_EMAIL')}\"")
    sh("git commit -m \"Version bump to #{next_version}\"")
    push_to_git_remote(local_branch: branch, remote_branch: branch)

    # create_pull_request swallows GitHub API errors (its error handler returns
    # from the action rather than raising -- a proc {} `return` returns from the
    # enclosing method), so a failed request would otherwise look like success.
    create_pull_request(
      api_token: ENV.fetch("GH_TOKEN"),
      repo: "twilio/twilio-verify-sna-android",
      title: "Release #{next_version}",
      base: "main",
      head: branch,
      body: notes
    )
    pr_url = lane_context[SharedValues::CREATE_PULL_REQUEST_HTML_URL]
    UI.user_error!("Failed to open the release PR for #{branch} -- see the GitHub API error above.") unless pr_url
    UI.success("Opened release PR: #{pr_url}")
  end

  desc "Publish the version in gradle.properties to Maven Central, Artifactory, and GitHub"
  lane :publish do
    version = gradle_property("verifySnaVersionName")

    if already_published_to_maven_central?(version)
      UI.important("#{version} is already on Maven Central; nothing to publish.")
      next
    end

    gradle(task: "sonatypeVerifySnaReleaseUpload")

    add_git_tag(tag: version)
    push_git_tags(tag: version)

    set_github_release(
      repository_name: "twilio/twilio-verify-sna-android",
      api_token: ENV.fetch("GH_TOKEN"),
      name: version,
      tag_name: version,
      description: latest_changelog_entry,
      commitish: "main"
    )

    gradle(task: "artifactoryLibraryReleaseUpload")
  end
end
